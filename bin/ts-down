#!/usr/bin/env bash
# Stop the workspace's tailscaled.
#
#   ts-down            ephemeral mode: log out (node removed at once), then stop
#                      persistent mode: stop only (login kept for next ts-up)
#   ts-down --logout   always log out first
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

logout=0
[ "$TS_PERSIST" = 1 ] || logout=1
case "${1:-}" in
--logout) logout=1 ;;
-h | --help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
"") ;;
*) ts_die "unknown argument: $1" ;;
esac

ts_resolve_bins
if ts_daemon_alive && [ "$logout" = 1 ]; then
	ts_cli logout 2>/dev/null || true
fi
ts_stop_daemon
echo "tailscaled stopped."
